#!/usr/bin/env bash

: << !
Name: open
Author: YJ
Email: yj1516268@outlook.com
Created Time: 2020-04-27 13:51:05

Description: Open URI -- 以默认程序打开指定的 URI

Attentions:
-

Depends:
- xdg-utils
!

####################################################################
#+++++++++++++++++++++++++ Define Variable ++++++++++++++++++++++++#
####################################################################
#------------------------- Program Variable
# program name
name=$(basename "$0")
readonly name
# program nversion
readonly major_version=0.3.1
readonly minor_version=20240425
readonly rel_version=1

#------------------------- Exit Code Variable
readonly normal=0   # 一切正常
readonly err_file=1 # 文件/路径类错误

#------------------------- Parameter Variable
# description variable
readonly desc="使用默认程序打开指定的 URI"

# command
open="xdg-open"
editor="nano"

####################################################################
#+++++++++++++++++++++++++ Define Function ++++++++++++++++++++++++#
####################################################################
#------------------------- Info Function
function helpInfo() {
  echo -e ""
  echo -e "\x1b[32m$name\x1b[0m \x1b[1m$desc\x1b[0m"
  echo -e "--------------------------------------------------"
  echo -e "Usage:"
  echo -e ""
  echo -e "     $name [OPTION]"
  echo -e ""
  echo -e "Options:"
  echo -e "     -h, --help            显示帮助信息"
  echo -e "     -v, --version         显示版本信息"
}

function versionInfo() {
  echo -e ""
  echo -e "\x1b[1m$name\x1b[0m version (\x1b[1m$major_version-$minor_version.$rel_version\x1b[0m)"
}

#------------------------- Feature Function
function checkCommand() {
  # 确定编辑器
  if command -v nvim &> /dev/null; then
    editor="nvim"
  elif command -v vim &> /dev/null; then
    editor="vim"
  elif command -v vi &> /dev/null; then
    editor="vi"
  fi
}

function main() {
  checkCommand

  uri=$1
  if [[ -d $uri ]]; then # 文件夹
    $open "$uri" > /dev/null 2>&1
    exit $normal
  elif [[ -f $uri ]]; then # 文件
    $editor "$uri"
    exit $normal
  elif [[ "$uri" == file://* ]]; then # URL
    if [[ -d "${uri#file://}" ]]; then
      $open "$uri" > /dev/null 2>&1
      exit $normal
    elif [[ -f "${uri#file://}" ]]; then
      $editor "$uri"
      exit $normal
    else
      echo -e "\x1b[31m'$uri' is not a file or directory\x1b[0m"
      exit $err_file
    fi
  elif [[ "$uri" == http://* || "$uri" == https://* || "$uri" == mailto:* || "$uri" == tel:* ]]; then # URL
    $open "$uri" > /dev/null 2>&1
    exit $normal
  else
    echo -e "\x1b[31mWhat is '$uri'\x1b[0m"
    exit $err_file
  fi
}

####################################################################
#++++++++++++++++++++++++++++++ Main ++++++++++++++++++++++++++++++#
####################################################################
ARGS=$(getopt --options "hv" --longoptions "help,version" -n "$name" -- "$@")
eval set -- "$ARGS"

if [[ ${#@} -lt 2 ]]; then
  main "$PWD"
else
  while true; do
    case $1 in
      -h | --help)
        helpInfo
        exit $normal
        ;;
      -v | --version)
        versionInfo
        exit $normal
        ;;
      --)
        shift 1
        ;;
      *)
        main "$1"
        ;;
    esac
  done
fi
