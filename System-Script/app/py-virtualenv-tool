#!/usr/bin/env bash

: << !
Name: py-virtualenv-tool
Author: YJ
Email: yj1516268@outlook.com
Created Time: 2023-02-09 11:00:29

Description: 用于操作 Python Virtualenv 环境的备份、创建和备份文件删除

Attentions:
-

Depends:
-
!

####################################################################
#+++++++++++++++++++++++++ Define Variable ++++++++++++++++++++++++#
####################################################################
#------------------------- Program Variable
# program name
name=$(basename "$0")
readonly name
# program version
readonly major_version=0.1.5
readonly minor_version=20240426
readonly rel_version=2

#------------------------- Exit Code Variable
readonly normal=0           # 一切正常
readonly err_file=1         # 文件/路径类错误
readonly err_no_program=127 # 未找到命令
readonly err_unknown=255    # 未知错误

#------------------------- Parameter Variable
# description variable
readonly desc="backup, creation, and backup file deletion for operating Python Virtualenv environments"
# environment variable
readonly storage="$HOME/.cache/SpiderData"
readonly app_virtualenv_dir="$storage/App/virtualenv"
# app variable
pip="pip"
virtualenvwrapper="/usr/bin/virtualenvwrapper.sh"
virtualenvwrapper_lazy="/usr/bin/virtualenvwrapper_lazy.sh"
# printf variable
readonly space='    '

####################################################################
#+++++++++++++++++++++++++ Define Function ++++++++++++++++++++++++#
####################################################################
#------------------------- Info Function
function helpInfo() {
  echo -e ""
  echo -e "\x1b[32m$name\x1b[0m \x1b[1m$desc\x1b[0m"
  echo -e "--------------------------------------------------"
  echo -e "Usage:"
  echo -e ""
  echo -e "     $name [OPTION]"
  echo -e ""
  echo -e "Options:"
  echo -e "     -d, --delete      Delete virtual environment backup files"
  echo -e "     -m, --make        Use files to build a virtual environment"
  echo -e "     -s, --save        Save virtual environment backup file"
  echo -e ""
  echo -e "     -h, --help        Show help information"
  echo -e "     -v, --version     Show version information"
}

function versionInfo() {
  echo -e ""
  echo -e "\x1b[1m$name\x1b[0m version (\x1b[1m$major_version-$minor_version.$rel_version\x1b[0m)"
}

#------------------------- Feature Function
function checkOS() {
  # 检测系统类型，确定因系统差异导致的变量或命令不同
  if [[ "$OSTYPE" == "darwin"* ]]; then
    pip="pip3.11"
    virtualenvwrapper="/opt/homebrew/bin/virtualenvwrapper.sh"
    virtualenvwrapper_lazy="/opt/homebrew/bin/virtualenvwrapper_lazy.sh"
  elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    pip="pip"
    virtualenvwrapper="/usr/bin/virtualenvwrapper.sh"
    virtualenvwrapper_lazy="/usr/bin/virtualenvwrapper_lazy.sh"
  fi
}

function initVirtualenv() {
  if [ -s "$virtualenvwrapper_lazy" ]; then
    # shellcheck source=/dev/null
    source "$virtualenvwrapper_lazy"
  elif [ -s "$virtualenvwrapper" ]; then
    # shellcheck source=/dev/null
    source "$virtualenvwrapper"
  else
    echo -e "Please install 'virtualenv' and 'virtualenvwrapper' first"
    exit $err_no_program
  fi
  venvs=$(workon)
}

function checkPath() {
  if [[ -e "$1" ]]; then
    if [[ ! -d "$1" ]]; then
      echo -e "Path '$1' is not a folder, exit"
      exit $err_file
    fi
  else
    mkdir -p "$1"
  fi
}

function checkCommand() {
  if command -v "$1" > /dev/null 2>&1; then
    return $normal
  else
    return $err_no_program
  fi
}

function deleteVirtualenvFile() {
  # 删除虚拟环境备份文件
  rm -rf "${app_virtualenv_dir:?}/"*
}

function saveVirtualenv() {
  if checkCommand "$pip"; then
    printf "%s %-14s \x1b[36m%s\x1b[0m %s\n" "$space" "Python-Venv" "-->" "$app_virtualenv_dir/*"
    for venv in ${venvs[*]}; do
      workon "$venv"
      filepath="$app_virtualenv_dir"/requirements_"$venv".txt
      pip freeze --no-python-version-warning > "$filepath"
      printf "%s%s Venv: \x1b[37m%s\x1b[0m \x1b[35m%2s\x1b[0m\n" "$space" "$space" "$venv" "✔"
    done
  else
    echo -e "Please install 'pip' first"
  fi
}

function makeVirtualenv() {
  if checkCommand "$pip"; then
    # 遍历存储的requirements*.txt，得到绝对路径表示的文件名
    if [ "$(ls -A "$app_virtualenv_dir")" ]; then
      for filepath in "$app_virtualenv_dir"/*.txt; do
        # 获取文件名并切分得到虚拟环境名
        filename=$(basename "$filepath")
        envname=$(echo "$filename" | cut -d "_" -f 3 | cut -d "." -f 1)
        # 将切分得到的虚拟环境名和现有虚拟环境名做对比
        if [[ ! "${venvs[*]}" =~ $envname ]]; then
          # 名字不同则创建并搭建环境
          mkvirtualenv -p python3 "$envname"
          workon "$envname"
          pip install -r "$filepath"
        fi
      done
    fi
  else
    echo -e "Please install 'pip' first"
  fi
}

####################################################################
#++++++++++++++++++++++++++++++ Main ++++++++++++++++++++++++++++++#
####################################################################
checkOS
initVirtualenv
mkdir -p "$app_virtualenv_dir"

ARGS=$(getopt --options "dsmhv" --longoptions "delete,save,make,help,version" -n "$name" -- "$@")
eval set -- "$ARGS"

if [[ ${#@} -lt 2 ]]; then
  helpInfo
else
  while true; do
    checkPath "$app_virtualenv_dir"
    case $1 in
      -d | --delete)
        deleteVirtualenvFile
        shift 1
        ;;
      -s | --save)
        saveVirtualenv
        shift 1
        ;;
      -m | --make)
        makeVirtualenv
        shift 1
        ;;
      -h | --help)
        helpInfo
        shift 1
        ;;
      -v | --version)
        versionInfo
        shift 1
        ;;
      --)
        shift 1
        break
        ;;
      *)
        helpInfo
        exit $err_unknown
        ;;
    esac
  done
fi
