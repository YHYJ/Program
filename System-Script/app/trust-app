#!/usr/bin/env bash

: << !
Name: trust-app
Author: YJ
Email: yj1516268@outlook.com
Created Time: 2024-02-23 13:18:59

Description: 使 macOS 信任指定程序

Attentions:
- 仅适用于 macOS

Depends:
-
!

####################################################################
#+++++++++++++++++++++++++ Define Variable ++++++++++++++++++++++++#
####################################################################
#------------------------- Program Variable
# Program name
name=$(basename "$0")
readonly name
# Program description
readonly desc="make macOS trust a specified program"
# Program version
readonly major_version=0.0.3
readonly minor_version=20240704
readonly rel_version=1

#------------------------- Exit Code Variable
readonly normal=0           # 一切正常
readonly err_file=1         # 文件/路径类错误
readonly err_no_program=127 # 未找到命令

####################################################################
#+++++++++++++++++++++++++ Define Function ++++++++++++++++++++++++#
####################################################################
#------------------------- Info Function
function helpInfo() {
  echo -e ""
  echo -e "\x1b[32m$name\x1b[0m \x1b[1m$desc\x1b[0m"
  echo -e "--------------------------------------------------"
  echo -e "Usage:"
  echo -e ""
  echo -e "     $name [OPTION]"
  echo -e ""
  echo -e "Options:"
  echo -e "     -h, --help        Show help information"
  echo -e "     -v, --version     Show version information"
}

function versionInfo() {
  echo -e ""
  echo -e "\x1b[1m$name\x1b[0m version (\x1b[1m$major_version-$minor_version.$rel_version\x1b[0m)"
}

#------------------------- Feature Function
function checkOS() {
  # 检测系统类型
  if [[ "$OSTYPE" != "darwin"* ]]; then
    echo "Only supports macOS"
    exit $err_no_program
  fi
}

function trustApp() {
  checkOS

  # 如果$1存在，输出1，否则输出错误
  if [[ -e $1 ]]; then
    xattr -rd com.apple.quarantine "$1"
    echo -e "\n\x1b[35m[✔]\x1b[0m \x1b[4;34m$1\x1b[0m is trusted"
  else
    echo -e "\n\x1b[31m[✘]\x1b[0m \x1b[34m$1\x1b[0m does not exist"
    exit $err_file
  fi
}

####################################################################
#++++++++++++++++++++++++++++++ Main ++++++++++++++++++++++++++++++#
####################################################################
ARGS=$(getopt --options "ahv" --longoptions "app:,help,version" -n "$name" -- "$@")
eval set -- "$ARGS"

if [[ ${#@} -lt 2 ]]; then
  helpInfo
else
  while true; do
    case $1 in
      -h | --help)
        helpInfo
        exit $normal
        ;;
      -v | --version)
        versionInfo
        exit $normal
        ;;
      --)
        shift 1
        ;;
      *)
        trustApp "$2"
        exit $normal
        ;;
    esac
  done
fi
